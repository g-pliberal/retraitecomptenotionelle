{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "modelSettings": {
    "claude-fable-5-2": { "effortLevel": "high" },
    "claude-opus-5-5": { "effortLevel": "high" },
    "claude-sonnet-5-5": { "effortLevel": "high" }
  },
  "fallbackModel": ["opus", "sonnet"],
  "enableArtifact": false,
  "disableWorkflows": true,
  "includeGitInstructions": false,
  "skillOverrides": {
    "artifact-capabilities": "off",
    "artifact-design": "off",
    "artifact-diagramming": "off",
    "dataviz": "off",
    "fewer-permission-prompts": "off",
    "init": "off",
    "keybindings-help": "off",
    "loop": "off",
    "plugin-authoring": "off",
    "run": "off"
  },
  "permissions": {
    "deny": [
      "Artifact",
      "Workflow",
      "ScheduleWakeup",
      "SearchPlugins",
      "SuggestPluginInstall",
      "SuggestSkills",
      "ShowOnboardingRolePicker",
      "ReportFindings",
      "ListAgents",
      "mcp__claude-code-remote__watch_url",
      "mcp__claude-code-remote__unwatch_url",
      "mcp__claude-code-remote__create_environment",
      "mcp__claude-code-remote__update_environment",
      "mcp__claude-code-remote__get_environment",
      "mcp__claude-code-remote__switch_environment",
      "mcp__claude-code-remote__list_environments",
      "mcp__claude-code-remote__request_credential",
      "mcp__claude-code-remote__create_trigger",
      "mcp__claude-code-remote__update_trigger",
      "mcp__claude-code-remote__list_triggers",
      "mcp__claude-code-remote__fire_trigger",
      "mcp__claude-code-remote__get_trigger",
      "mcp__claude-code-remote__list_computer_folders",
      "mcp__claude-code-remote__request_computer_folder",
      "mcp__claude-code-remote__subscribe_pr_activity",
      "mcp__claude-code-remote__unsubscribe_pr_activity",
      "mcp__claude-code-remote__add_repo",
      "mcp__claude-code-remote__register_repo_root",
      "mcp__claude-code-remote__list_repos",
      "mcp__Claude_Docs__*",
      "mcp__Google_Docs__*",
      "mcp__Google_Drive__*",
      "mcp__Google_Sheets__*",
      "mcp__Google_Slides__*"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh\"",
            "timeout": 300,
            "statusMessage": "Installation des dépendances"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/etat-suite.sh\"",
            "timeout": 10,
            "statusMessage": "Verdict de la suite sur GitHub"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/lecture.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/tdd.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/scripts/pousser.sh\"",
            "timeout": 120,
            "statusMessage": "Publication sur main"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/scripts/pousser.sh\"",
            "timeout": 120,
            "statusMessage": "Publication sur main, après une erreur de l'API"
          }
        ]
      }
    ]
  }
}
